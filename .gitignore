# ===========================================================================
# .gitignore - DOCX OCR to Google Sheets
# ===========================================================================

# ── 敏感資訊（絕對不要提交！）──────────────────────────────────────────────
credentials.json
*-credentials.json
service-account*.json
service_account.json
.env
.env.local
secrets/

# ── 專案資料夾（內容是個別使用者的資料，不適合上版控）─────────────────────
docs/*
# agent skills 設定檔（無個資）納入版控；docs/ 其餘（真實契約）仍忽略
!docs/agents/
!docs/agents/**
work/
output/
*.docx
*.pdf
!sample/*.docx              # 若有放範例,可保留 sample 資料夾下的檔案

# ── 仲介名冊資料檔（政府開放資料，2.2MB 且會隨時間變舊，手動下載更新）──────
# 來源：data.gov.tw dataset 6682 的 JSON；下載後放到 data/agency_roster.json
data/agency_roster.json

# ── 全國門牌地址資料檔（政府開放資料，2.4MB，供 address_db.py 地址標準化）────
# 來源：data.gov.tw 縣市→行政區→路街 中英對照 JSON；下載後放到 data/AllData.json
data/AllData.json

# ── 真實契約樣本 / 資料壓縮檔（含個資，絕不上版控）────────────────────────
samples/
*.7z
*.zip

# ── Python 快取與虛擬環境 ─────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
# VSCode Code Runner 暫存檔
tempCodeRunnerFile.py

# 虛擬環境
.venv/
venv/
env/
ENV/
.virtualenv/

# 套件管理
*.egg-info/
*.egg
dist/
build/
pip-log.txt
pip-delete-this-directory.txt

# ── 測試與覆蓋率 ──────────────────────────────────────────────────────────
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover

# ── IDE / 編輯器 ──────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.project
.pydevproject

# Jupyter
.ipynb_checkpoints/
*.ipynb

# ── 作業系統 ──────────────────────────────────────────────────────────────
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.fuse_hidden*
.directory
.Trash-*

# ── 日誌與暫存 ────────────────────────────────────────────────────────────
*.log
*.tmp
*.bak
*.backup
logs/

# ── 掃描輸出（生成資料，不進版控）────────────────────────────────────────
scan_results/
benchmark_results/

# ── OCR 中間產物 ──────────────────────────────────────────────────────────
*.zip
comparison.png              # 前處理對比圖（除錯用）
*_raw.pdf                   # 中間 PDF
*_ocr.pdf                   # OCR 後 PDF
results_backup.csv

# ── Agent skills（個人開發工具，隨時可重裝，不進版控）──────────────────────
# 這些是 markdown 設定檔，同事跑 執行.bat 完全用不到（不需要 Node.js）。
# skills-lock.json 刻意「保留」版控：它記錄裝了哪些 skill 與版本雜湊，換機可據以重裝。
# 真正該共用的 agent 設定在 docs/agents/（見上方 !docs/agents/）。
.claude/skills/
.agents/skills/

# ── 其他 ──────────────────────────────────────────────────────────────────
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
